---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import PackageGrid from '../components/PackageGrid.astro';
import BranchGrid from '../components/BranchGrid.astro';
import TestimonialGrid from '../components/TestimonialGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CTASection from '../components/CTASection.astro';
import {
	benefits,
	faqs,
	packages,
	services,
	testimonials,
} from '../data/home';
import { branches } from '../data/branches';
import { bookingAction } from '../data/site';
---

<SiteLayout
	title="نجم سبا - مساج وحمام مغربي في حفر الباطن"
	description="مركز استرخاء الجسد والعقل والروح — خدمات متميزة بأيدي أخصائيين محترفين"
	pathname="/"
	pageType="WebPage"
	image="/assets/home/hero-slider.jpg"
	faqItems={faqs}
	services={services}
>
	<div data-home-intro-shell data-hero-shell class="bg-bg-primary">
		<Header currentPage="home" />
		<HomeHero
			eyebrow="تجربة سبا فاخرة في المملكة"
			title="استرخِ، استعد طاقتك،"
			highlightedTitle="واستمتع بلحظتك"
			description="اكتشف تجربة سبا متكاملة صُممت لتجدد جسمك، تهدئ ذهنك، وتمنحك شعورًا عميقًا بالراحة"
			descriptionLine2="والاسترخاء."
			image="/assets/home/hero-slider.jpg"
			primaryAction={{ label: 'احجز موعدك الآن', href: bookingAction.href }}
			secondaryAction={{ label: 'اكتشف خدماتنا', href: '#services' }}
			proofPoints={['أجواء هادئة وخاصة', 'منتجات عالية الجودة', 'معالجون محترفون']}
		/>
	</div>

	<section id="services" class="section-block scroll-mt-20 bg-bg-tertiary">
		<div class="page-container">
			<SectionHeading
				eyebrow="خدماتنا"
				title="تجربة سبا متكاملة"
				description="اختر من بين مجموعة واسعة من خدمات المساج والحمام المغربي والعناية الشخصية"
				align="center"
			/>
			<div class="mt-14">
				<ServiceGrid services={services} />
			</div>
		</div>
	</section>

	<section data-home-benefits class="section-block bg-bg-primary">
		<div class="page-container">
			<SectionHeading
				eyebrow="لماذا نجم سبا؟"
				title="تجربة لا تُنسى"
				description="نجم بين الخبرة والاحترافية والأجواء الهادئة لنمنحك أفضل تجربة سبا في المنطقة"
				align="center"
			/>
			<div class="mt-14">
				<FeatureGrid features={benefits} />
			</div>
		</div>
	</section>

	<section id="packages" class="section-block scroll-mt-20 bg-bg-tertiary">
		<div class="page-container">
			<SectionHeading
				eyebrow="باقاتنا"
				title="باقات مختارة بعناية"
				description="تجارب متكاملة تجمع خدماتنا الأكثر تميزًا بقيمة استثنائية."
				align="center"
			/>
			<div class="mt-12">
				<PackageGrid packages={packages} />
			</div>
		</div>
	</section>

		<section id="branches" class="section-block scroll-mt-20 bg-bg-secondary">
		<div class="page-container">
			<SectionHeading
				eyebrow="الفروع"
				title="فروعنا في المملكة"
				description="ثلاثة فروع فاخرة تنتظرك في أهم المدن."
				align="center"
			/>
			<div class="mt-14">
				<BranchGrid branches={branches} />
			</div>
		</div>
	</section>

	<section id="reviews" class="section-block scroll-mt-20 bg-bg-primary">
		<div class="page-container">
			<SectionHeading
				eyebrow="آراء العملاء"
				title="آراء من واقع التجربة"
				description="تجارب حقيقية من عملاء نجم سبا."
				align="center"
			/>
			<div class="mt-14">
				<TestimonialGrid testimonials={testimonials} />
			</div>
		</div>
	</section>

	<section id="faq" class="section-block scroll-mt-20 bg-bg-primary">
		<div class="page-container">
			<SectionHeading
				eyebrow="الأسئلة الشائعة"
				title="أسئلة قد تخطر ببالك"
				description="إجابات سريعة تساعدك على الاستعداد لزيارتك."
				align="center"
			/>
			<div class="mt-14">
				<FaqAccordion items={faqs} />
			</div>
		</div>
	</section>

	<CTASection
		title="جاهز لتجربة الاسترخاء؟"
		description="احجز موعدك الآن عبر واتساب أو اتصل بنا مباشرة — فريقنا في انتظارك"
		primaryAction={{ label: 'تواصل عبر واتساب', href: bookingAction.href }}
		secondaryAction={{ label: 'معلومات التواصل', href: '/contact' }}
	/>
</SiteLayout>
