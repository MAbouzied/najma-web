---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HeroSection from '../../components/HeroSection.astro';
import PackageGrid from '../../components/PackageGrid.astro';
import CTASection from '../../components/CTASection.astro';
import { packages } from '../../data/home';
import { bookingAction } from '../../data/site';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'باقاتنا', href: '/packages/' },
];
---

<SiteLayout
  title="باقاتنا - نجم سبا"
  description="تصفح باقات نجم سبا المميزة: باقة العرسان لتجهيز يوم الزفاف، باقة الرفاهية للاسترخاء التام، وباقة الإهداء لمن تحب — تجارب متكاملة بأسعار تنافسية."
  pathname="/packages/"
  pageType="WebPage"
  image="/assets/home/hero-interior.png"
  breadcrumbs={breadcrumbs}
  packages={packages}
>
  <div data-hero-shell class="bg-bg-hero">
    <Header currentPage="packages" />
    <div class="page-container pt-6">
      <Breadcrumbs items={breadcrumbs} class="mb-0" />
    </div>
    <HeroSection
      badge="باقاتنا"
      description="جربنا باقاتنا المتكاملة المصممة بعناية لتمنحك أقصى درجات الاسترخاء والعناية — اختر الباقة التي تناسب احتياجك."
    >
      <Fragment slot="title">
        <span class="text-gold-gradient">باقات</span>
        <span class="text-text-primary"> العناية المثالية</span>
      </Fragment>
    </HeroSection>
  </div>

  <section class="section-block bg-bg-primary">
    <div class="page-container">
      <PackageGrid packages={packages} />
    </div>
  </section>

  <CTASection
    title="باقة تناسب احتياجك"
    description="اختر باقتك المفضلة واحجزها الآن عبر واتساب — فريقنا جاهز لخدمتك"
    primaryAction={{ label: 'احجز باقتك الآن', href: bookingAction.href }}
    secondaryAction={{ label: 'تواصل معنا', href: '/contact' }}
  />
</SiteLayout>
