---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import HeroSection from '../../components/HeroSection.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import CTASection from '../../components/CTASection.astro';
import { services } from '../../data/home';
import { bookingAction } from '../../data/site';

const breadcrumbs = [
  { label: 'الرئيسية', href: '/' },
  { label: 'خدماتنا', href: '/services/' },
];
---

<SiteLayout
  title="خدماتنا - نجم سبا"
  description="اكتشف خدمات نجم سبا المتميزة في حفر الباطن: مساج استرخاء، مساج سويدي، مساج تايلندي، مساج شياتسو، حمام مغربي، مساج أحجار ساخنة، مساج بنتوسا، تدليك علاجي، والعناية بالقدمين."
  pathname="/services/"
  pageType="WebPage"
  image="/assets/home/hero-interior.png"
  breadcrumbs={breadcrumbs}
  services={services}
>
  <div data-hero-shell class="bg-bg-hero">
    <Header currentPage="services" />
    <div class="page-container pt-6">
      <Breadcrumbs items={breadcrumbs} class="mb-0" />
    </div>
    <HeroSection
      badge="خدماتنا"
      description="نقدم لك تشكيلة متكاملة من خدمات المساج والحمام المغربي بأيدي أخصائيين محترفين — كل خدمة صممت لتمنحك لحظة استرخاء لا تُنسى."
    >
      <Fragment slot="title">
        <span class="text-gold-gradient">خدماتنا</span>
        <span class="text-text-primary"> المتميزة</span>
      </Fragment>
    </HeroSection>
  </div>

  <section class="section-block bg-bg-primary">
    <div class="page-container">
      <ServiceGrid services={services} />
    </div>
  </section>

  <CTASection
    title="جاهز لتجربة الاسترخاء؟"
    description="احجز موعدك الآن عبر واتساب — فريقنا في انتظارك"
    primaryAction={{ label: 'احجز تجربتك الآن', href: bookingAction.href }}
    secondaryAction={{ label: 'تواصل معنا', href: '/contact' }}
  />
</SiteLayout>
