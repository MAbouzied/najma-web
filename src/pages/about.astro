---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import SplitMediaSection from '../components/SplitMediaSection.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTASection from '../components/CTASection.astro';
import { bookingAction } from '../data/site';

const values = [
  {
    icon: '/assets/about/icons/trusted-expertise.svg',
    title: 'خبرة موثوقة',
    description: 'فريق مؤهل بسنوات من الخبرة في فنون العناية والاسترخاء.',
  },
  {
    icon: '/assets/about/icons/exceptional-quality.svg',
    title: 'جودة استثنائية',
    description: 'مستحضرات وزيوت عضوية من علامات عالمية مختارة بعناية.',
  },
  {
    icon: '/assets/about/icons/authentic-nature.svg',
    title: 'أصالة وطبيعة',
    description: 'طقوس مستوحاة من التقاليد العربية بلمسة معاصرة راقية.',
  },
  {
    icon: '/assets/about/icons/calm-atmosphere.svg',
    title: 'أجواء ساكنة',
    description: 'تصميم داخلي هادئ يبعث الطمأنينة من اللحظة الأولى.',
  },
  {
    icon: '/assets/about/icons/complete-privacy.svg',
    title: 'خصوصية تامة',
    description: 'غرف علاج مخصصة لضمان راحتك الكاملة دون مقاطعات.',
  },
  {
    icon: '/assets/about/icons/complete-service.svg',
    title: 'خدمة متكاملة',
    description: 'تجربة مصممة بعناية من الاستقبال حتى الوداع.',
  },
];

const stats = [
  { value: '٣', label: 'فروع فاخرة' },
  { value: '+٢٠ ألف', label: 'عميل سعيد' },
  { value: '+٥٠', label: 'معالج محترف' },
  { value: '+١٢', label: 'سنة خبرة' },
];
---

<SiteLayout
  title="من نحن - نجم سبا"
  description="تعرّف على قصة نجم سبا، حيث تلتقي الأصالة بالرفاهية في تجربة استرخاء لا تُنسى."
  pathname="/about/"
  pageType="AboutPage"
  image="/assets/about/mission.jpg"
  breadcrumbLabel="من نحن"
>
  <div data-hero-shell class="bg-bg-hero">
    <Header currentPage="about" />
    <HeroSection
      badge="قصتنا"
      description="وُلد نجم سبا من شغفٍ عميق بتقديم تجربة استرخاء تتجاوز التوقعات، تجربة تحتفي بالتفاصيل الصغيرة وتمنحك لحظة"
      descriptionLine2="صافية بعيدًا عن ضجيج الحياة."
    >
      <Fragment slot="title">
        <span class="text-gold-gradient">نجم سبا</span>
        <span class="text-text-primary"> - حيث تلتقي الأصالة</span>
        <br />
        <span class="text-text-primary">بالرفاهية</span>
      </Fragment>
    </HeroSection>
  </div>

  <SplitMediaSection
    eyebrow="رسالتنا"
    title="تجربة سبا لا تُنسى"
    paragraphs={[
      'في نجم سبا نؤمن أن الاسترخاء فنٌّ يستحق أن يُمارَس بأعلى معايير الجودة. نحرص على أن تكون كل جلسة رحلة متكاملة للحواس، من العطر الذي يستقبلك، إلى الموسيقى الهادئة، وصولاً إلى لمسات المعالج المتقنة.',
      'نمزج بين الطقوس التقليدية الأصيلة والأساليب الحديثة في العناية، لنقدم تجربة راقية تلائم ذوق الضيف العربي، وتحترم خصوصيته، وتعكس شغفنا بالتفاصيل الفاخرة.',
    ]}
    image="/assets/about/mission.jpg"
    imageAlt="أجواء نجم سبا"
    imagePosition="right"
    surface="secondary"
  >
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        stats.map((stat) => (
          <div class="rounded-[20px] border border-border-card bg-bg-card/60 p-4 text-center">
            <p class="text-2xl font-bold tracking-[0.24px] text-gold">{stat.value}</p>
            <p class="mt-1 text-xs leading-4 text-text-muted">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </SplitMediaSection>

  <section class="section-block bg-bg-tertiary">
    <div class="page-container">
      <SectionHeading
        eyebrow="قيمنا"
        title="ما يميزنا"
        description="قيم راسخة نلتزم بها في كل زيارة، لتشعر بالفرق منذ اللحظة الأولى."
        align="center"
      />
      <div class="mt-14">
        <FeatureGrid features={values} columns={3} />
      </div>
    </div>
  </section>

  <SplitMediaSection
    eyebrow="رؤيتنا"
    title="أن نكون وجهتك المفضلة للراحة"
    paragraphs={[
      'نطمح أن يكون نجم سبا مرجعًا في عالم السبا الفاخر في المنطقة، عبر الاستثمار في أفضل المعالجين، وأرقى المنتجات، وتصميم مساحات تعكس هدوء الروح ورقي الذوق.',
    ]}
    image="/assets/contact-cta.jpg"
    imageAlt="جلسة مساج في نجم سبا"
    imagePosition="left"
    surface="primary"
    primaryAction={{ label: 'تواصل معنا', href: '/contact' }}
    secondaryAction={{ label: 'استكشف خدماتنا', href: '/#services' }}
  />

  <CTASection
    title="لحظتك من الراحة تبدأ هنا"
    description="ابتعد عن ضغوط يومك واستمتع بتجربة عناية واسترخاء صُممت خصيصًا لك في نجم سبا."
    primaryAction={{ label: 'احجز تجربتك الآن', href: bookingAction.href }}
    secondaryAction={{ label: 'تواصل معنا', href: '/contact' }}
  />
</SiteLayout>
