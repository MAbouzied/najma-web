---
interface Props {
  measurementId: string;
  /** Extra gtag config IDs, including the Google Ads account. */
  configIds?: string[];
  /** Set on the contact conversion page only. */
  conversionSendTo?: string;
}

const { measurementId, configIds = [], conversionSendTo = '' } = Astro.props;
const adsId = configIds.find((id) => id.startsWith('AW-')) ?? '';
---

<meta name="gtm-container-id" content={measurementId} />
{adsId && <meta name="google-ads-id" content={adsId} />}

<script
  is:inline
  define:vars={{
    gtmId: measurementId,
    configIds,
    conversionSendTo,
  }}
>
  window.dataLayer = window.dataLayer || [];

  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', gtmId);
  for (var i = 0; i < configIds.length; i += 1) {
    if (configIds[i] && configIds[i] !== gtmId) {
      gtag('config', configIds[i]);
    }
  }
  if (conversionSendTo) {
    gtag('event', 'conversion', { send_to: conversionSendTo });
  }

  var gaScript = document.createElement('script');
  gaScript.async = true;
  gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + gtmId;
  document.head.appendChild(gaScript);
</script>

<script>
  import { isContactConversionPath, trackGoogleAdsConversion } from '../lib/google-ads';
  import { pushGtmEvent } from '../lib/gtm';

  const SAME_TAB_PROTOCOLS = ['tel:', 'mailto:'];
  const NAVIGATION_DELAY_MS = 150;

  function readDataset(el: HTMLElement, key: 'gtmEvent' | 'gtmLocation') {
    return el.dataset[key]?.trim() || undefined;
  }

  function isSameTabContactLink(el: HTMLAnchorElement) {
    const href = el.getAttribute('href')?.toLowerCase() ?? '';
    return SAME_TAB_PROTOCOLS.some((protocol) => href.startsWith(protocol));
  }

  function trackFromElement(el: HTMLElement, onReady?: () => void) {
    const eventName = readDataset(el, 'gtmEvent');
    if (!eventName) {
      onReady?.();
      return;
    }

    const location = readDataset(el, 'gtmLocation');
    const params: Record<string, string | number | (() => void) | undefined> = { location };

    if (el instanceof HTMLAnchorElement) {
      params.link_url = el.href;
    }

    if (el instanceof HTMLFormElement) {
      params.form_id = el.id || undefined;
      const serviceInput = el.querySelector('[name="service"]');
      if (serviceInput instanceof HTMLInputElement || serviceInput instanceof HTMLTextAreaElement) {
        params.service = serviceInput.value || undefined;
      }
    }

    if (onReady) {
      let settled = false;
      const finish = () => {
        if (settled) {
          return;
        }
        settled = true;
        onReady();
      };

      params.eventCallback = finish;
      params.eventTimeout = NAVIGATION_DELAY_MS;
      pushGtmEvent(eventName, params);
      window.setTimeout(finish, NAVIGATION_DELAY_MS);
      return;
    }

    pushGtmEvent(eventName, params);
  }

  function onClick(event: Event) {
    const target = event.target;
    if (!(target instanceof Element)) {
      return;
    }

    const el = target.closest('[data-gtm-event]');
    if (!(el instanceof HTMLElement) || el instanceof HTMLFormElement) {
      return;
    }

    if (el.closest('form[data-gtm-event]')) {
      return;
    }

    if (el instanceof HTMLAnchorElement && isSameTabContactLink(el)) {
      event.preventDefault();
      const href = el.href;
      trackFromElement(el, () => {
        window.location.href = href;
      });
      return;
    }

    trackFromElement(el);
  }

  function onSubmit(event: Event) {
    const form = event.target;
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    if (!form.dataset.gtmEvent) {
      return;
    }

    trackFromElement(form);
  }

  if (!window.__nagmGtmBound) {
    document.addEventListener('click', onClick, true);
    document.addEventListener('submit', onSubmit, true);
    document.addEventListener('nagm:page-load', () => {
      if (isContactConversionPath(window.location.pathname)) {
        trackGoogleAdsConversion();
      }
    });
    window.__nagmGtmBound = true;
  }
</script>
