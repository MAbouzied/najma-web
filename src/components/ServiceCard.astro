---
import { Image } from 'astro:assets';
import { buildServiceBookingUrl } from '../lib/whatsapp';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';
import { localImage } from '../lib/site-images';
import ContactActions from './ContactActions.astro';
import UiIcon from './UiIcon.astro';

export interface Props {
  service: {
    slug: string;
    image: string;
    title: string;
    description: string;
    duration?: string;
    price?: string;
  };
  locale?: Locale;
}

const { service, locale = 'ar' } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const detailHref = localePath(`/services/${service.slug}/`, locale);
const bookingHref = buildServiceBookingUrl(service.title, locale);
const priceLabel = service.price ?? (locale === 'en' ? 'Via offers' : 'ضمن العروض');
const cardImage = localImage(service.image);
---

<article
  data-service-card
  class="group flex h-full flex-col overflow-hidden rounded-[20px] border border-border-card bg-bg-card transition-transform hover:-translate-y-1"
>
  <a href={detailHref} class="block flex-1">
    <div class="relative h-56 overflow-hidden">
      <Image
        src={cardImage}
        alt=""
        widths={[320, 480, 640]}
        sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 1023px) calc(50vw - 56px), 286px"
        format="webp"
        quality="mid"
        loading="lazy"
        decoding="async"
        class="size-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-bg-card via-transparent to-transparent"></div>
    </div>
    <div class="p-6 pb-4" dir={dir}>
      <h3 class="text-xl font-bold text-text-primary">{service.title}</h3>
      <p class="mt-2 min-h-12 text-sm leading-6 text-text-muted">{service.description}</p>
      <div class="mt-5 flex items-center justify-between border-t border-border-card pt-4">
        <span class="font-bold text-gold">{priceLabel}</span>
        {service.duration && (
          <span class="flex items-center gap-2 text-xs text-text-muted">
            <UiIcon name="hours" class="size-[15px]" />
            {service.duration}
          </span>
        )}
      </div>
    </div>
  </a>
  <div class="px-6 pb-6">
    <ContactActions
      whatsappHref={bookingHref}
      whatsappLabel={t(locale, 'actionWhatsapp')}
      gtmLocation="service_card"
      callLabel={t(locale, 'actionCall')}
      size="compact"
      class="w-full"
      locale={locale}
    />
  </div>
</article>
