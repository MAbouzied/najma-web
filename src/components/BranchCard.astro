---
import type { Branch } from '../data/branches';
import { GTM_EVENTS, gtmContactAttrs } from '../lib/gtm';
import { buildWhatsAppUrl } from '../lib/whatsapp';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';
import ContactActions from './ContactActions.astro';

export interface Props {
  branch: Branch;
  locale?: Locale;
}

const { branch, locale = 'ar' } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const branchBookingHref = buildWhatsAppUrl(
  locale === 'en'
    ? `Hello, I would like to book at ${branch.title}`
    : `أهلاً، أريد الحجز في ${branch.title}`,
);
---

<article
  data-branch-card
  class="rounded-[20px] border border-border-card bg-bg-card p-6 text-start sm:p-8"
  dir={dir}
>
  <h3 class="text-xl font-semibold leading-7 tracking-[0.2px] text-text-primary">{branch.title}</h3>
  <dl class="mt-4 flex flex-col gap-3 text-sm leading-5 text-text-muted">
    <div>
      <dt class="sr-only">{locale === 'en' ? 'Address' : 'العنوان'}</dt>
      <dd class="flex items-center gap-2">
        <img src="/assets/icons/location.svg" alt="" width="16" height="16" class="size-4 shrink-0" />
        <span>{branch.address}</span>
      </dd>
    </div>
    <div>
      <dt class="sr-only">{locale === 'en' ? 'Hours' : 'ساعات العمل'}</dt>
      <dd class="flex items-center gap-2">
        <img src="/assets/icons/hours.svg" alt="" width="16" height="16" class="size-4 shrink-0" />
        <span>{branch.hours}</span>
      </dd>
    </div>
    <div>
      <dt class="sr-only">{t(locale, 'contactLabelPhone')}</dt>
      <dd class="flex items-center gap-2" dir="ltr">
        <img src="/assets/icons/branch-phone.svg" alt="" width="16" height="16" class="size-4 shrink-0" />
        {branch.phoneHref ? (
          <a
            href={branch.phoneHref}
            class="transition-colors hover:text-gold"
            {...gtmContactAttrs(GTM_EVENTS.call, 'branch_card')}
          >
            {branch.phone}
          </a>
        ) : (
          <span>{branch.phone}</span>
        )}
      </dd>
    </div>
  </dl>
  <div class="mt-6 flex flex-col gap-2">
    <ContactActions
      whatsappHref={branchBookingHref}
      whatsappLabel={t(locale, 'actionWhatsapp')}
      callLabel={t(locale, 'actionCall')}
      size="compact"
      gtmLocation="branch_card"
      locale={locale}
    />
    {branch.mapsHref && (
      <a
        href={branch.mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="outline-button min-h-0 w-full px-4 py-2 text-xs font-normal text-text-muted"
      >
        {t(locale, 'actionDirections')}
      </a>
    )}
  </div>
</article>
