---
import SocialLinks from './SocialLinks.astro';
import UiIcon from './UiIcon.astro';
import type { Branch } from '../data/branches';
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';

export interface Props {
  sectionLabel: string;
  title?: string;
  branches: Branch[];
  locale?: Locale;
}

const { sectionLabel, branches, locale = 'ar', title } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const heading = title ?? t(locale, 'contactBranchesHeading');
---

<article id="branches" class="py-8" dir={dir}>
  <span class="text-sm font-medium text-gold">{sectionLabel}</span>
  <h2 class="text-gold-gradient mt-2 text-start text-4xl font-bold leading-tight tracking-[0.48px] sm:text-5xl">
    {heading}
  </h2>

  <div class="mt-6 flex flex-col gap-4">
    {
      branches.map((branch) => (
        <div class="rounded-[20px] border border-border-card bg-bg-social p-6">
          <h3 class="text-lg font-semibold leading-7 tracking-[0.18px] text-gold">{branch.title}</h3>
          <dl class="mt-3 flex flex-col gap-2 text-sm text-text-muted">
            <div>
              <dt class="sr-only">{locale === 'en' ? 'Address' : 'العنوان'}</dt>
              <dd class="flex items-start gap-2">
                <UiIcon name="location" class="mt-0.5 size-4 text-gold" />
                <span>{branch.address}</span>
              </dd>
            </div>
            <div>
              <dt class="sr-only">{t(locale, 'contactLabelHours')}</dt>
              <dd class="flex items-start gap-2">
                <UiIcon name="hours" class="mt-0.5 size-4 text-gold" />
                <span>{branch.hours}</span>
              </dd>
            </div>
            <div>
              <dt class="sr-only">{t(locale, 'contactLabelPhone')}</dt>
              <dd class="flex items-start gap-2">
                <UiIcon name="phone" class="mt-0.5 size-4 text-gold" />
                <span dir="ltr">{branch.phone}</span>
              </dd>
            </div>
          </dl>
        </div>
      ))
    }
  </div>

  <div class="mt-8 flex justify-start">
    <SocialLinks showLabel locale={locale} />
  </div>
</article>
