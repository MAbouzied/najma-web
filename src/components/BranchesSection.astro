---
import SocialLinks from './SocialLinks.astro';
import type { Branch } from '../data/branches';

export interface Props {
  sectionLabel: string;
  branches: Branch[];
}

const { sectionLabel, branches } = Astro.props;
---

<article id="branches" class="py-8" dir="rtl">
  <span class="text-sm font-medium text-gold">{sectionLabel}</span>
  <h2 class="text-gold-gradient mt-2 text-right text-4xl font-bold leading-tight tracking-[0.48px] sm:text-5xl">
    زُرنا في أقرب فرع
  </h2>

  <div class="mt-6 flex flex-col gap-4">
    {
      branches.map((branch) => (
        <div class="rounded-[20px] border border-border-card bg-bg-social p-6">
          <h3 class="text-lg font-semibold leading-7 tracking-[0.18px] text-gold">{branch.title}</h3>
          <dl class="mt-3 flex flex-col gap-2 text-sm text-text-muted">
            <div class="flex items-start gap-2">
              <img src="/assets/icons/location.svg" alt="" width="16" height="16" class="mt-0.5 size-4 shrink-0" />
              <dt class="sr-only">العنوان</dt>
              <dd>{branch.address}</dd>
            </div>
            <div class="flex items-start gap-2">
              <img src="/assets/icons/hours.svg" alt="" width="16" height="16" class="mt-0.5 size-4 shrink-0" />
              <dt class="sr-only">ساعات العمل</dt>
              <dd>{branch.hours}</dd>
            </div>
            <div class="flex items-start gap-2">
              <img src="/assets/icons/branch-phone.svg" alt="" width="16" height="16" class="mt-0.5 size-4 shrink-0" />
              <dt class="sr-only">رقم الهاتف</dt>
              <dd dir="ltr">{branch.phone}</dd>
            </div>
          </dl>
        </div>
      ))
    }
  </div>

  <div class="mt-8 flex justify-start">
    <SocialLinks showLabel />
  </div>
</article>
