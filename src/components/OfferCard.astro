---
import { buildOfferBookingUrl } from '../lib/whatsapp';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';
import ContactActions from './ContactActions.astro';

export interface Props {
  offer: {
    slug: string;
    image?: string;
    name: string;
    subtitle: string;
    description: string;
    price: string;
    originalPrice?: string;
    features: string[];
  };
  locale?: Locale;
}

const { offer, locale = 'ar' } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const detailHref = localePath(`/offers/${offer.slug}/`, locale);
const bookingHref = buildOfferBookingUrl(offer.name, locale);
const detailLabel = locale === 'en' ? 'View Details' : 'عرض التفاصيل';
const srLabel = locale === 'en' ? 'Price before discount ' : 'السعر قبل الخصم ';
---

<article
  data-offer-card
  class="relative flex h-full flex-col overflow-hidden rounded-3xl border border-border-card bg-bg-card transition-transform hover:-translate-y-1"
  dir={dir}
>
  <a href={detailHref} class="group flex flex-1 flex-col">
    {offer.image && (
      <div class="overflow-hidden">
        <img
          src={offer.image}
          alt={`${offer.name} — ${offer.price}`}
          width="723"
          height="1024"
          loading="lazy"
          decoding="async"
          class="aspect-[723/1024] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      </div>
    )}
    <div class="flex flex-1 flex-col p-6 sm:p-7">
      <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
        <h3 class="text-xl font-bold text-text-primary">{offer.name}</h3>
        <span class="flex items-baseline gap-2">
          <span class="text-2xl font-bold text-gold">{offer.price}</span>
          {offer.originalPrice && (
            <s class="text-sm text-text-muted">
              <span class="sr-only">{srLabel}</span>
              {offer.originalPrice}
            </s>
          )}
        </span>
      </div>
      <span class="outline-button mt-6 w-full text-center">{detailLabel}</span>
    </div>
  </a>
  <div class="px-6 pb-6 sm:px-7 sm:pb-7">
    <ContactActions
      whatsappHref={bookingHref}
      whatsappLabel={t(locale, 'actionWhatsapp')}
      callLabel={t(locale, 'actionCall')}
      size="compact"
      class="w-full"
      gtmLocation="offer_card"
      locale={locale}
    />
  </div>
</article>
