---
import { buildPackageBookingUrl } from '../lib/whatsapp';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';
import ContactActions from './ContactActions.astro';

export interface Props {
  packageItem: {
    slug: string;
    name: string;
    subtitle: string;
    description: string;
    price: string;
    originalPrice?: string;
    features: string[];
    featured?: boolean;
  };
  locale?: Locale;
}

const { packageItem, locale = 'ar' } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const detailHref = localePath(`/packages/${packageItem.slug}/`, locale);
const bookingHref = buildPackageBookingUrl(packageItem.name, locale);
const featuredLabel = locale === 'en' ? 'Most Popular' : 'الأكثر طلبًا';
const detailLabel = locale === 'en' ? 'View Details' : 'عرض التفاصيل';
const srLabel = locale === 'en' ? 'Price before discount ' : 'السعر قبل الخصم ';
---

<article
  data-package-card
  class:list={[
    'relative flex h-full flex-col rounded-3xl border p-7 transition-transform hover:-translate-y-1 sm:p-8',
    packageItem.featured
      ? 'border-gold bg-bg-form shadow-[0_24px_70px_-35px_var(--color-gold)] lg:-translate-y-4'
      : 'border-border-card bg-bg-card',
  ]}
  dir={dir}
>
  {packageItem.featured && (
    <span class:list={[
      'absolute -top-3 rounded-full bg-gold-gradient px-4 py-1 text-xs font-bold text-text-btn',
      locale === 'en' ? 'left-8' : 'right-8',
    ]}>
      {featuredLabel}
    </span>
  )}
  <a href={detailHref} class="flex flex-1 flex-col">
    <h3 class="text-2xl font-bold text-text-primary">{packageItem.name}</h3>
    <p class="mt-2 text-sm text-text-muted">{packageItem.subtitle}</p>
    <p class="mt-6 flex flex-wrap items-baseline gap-3">
      <span class="text-3xl font-bold text-gold">{packageItem.price}</span>
      {packageItem.originalPrice && (
        <s class="text-lg text-text-muted">
          <span class="sr-only">{srLabel}</span>
          {packageItem.originalPrice}
        </s>
      )}
    </p>
    <ul class="mt-6 flex flex-1 flex-col gap-3">
      {packageItem.features.map((feature) => (
        <li class="flex items-start gap-3 text-sm leading-6 text-text-muted">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
          {feature}
        </li>
      ))}
    </ul>
    <span class="outline-button mt-8 w-full text-center">{detailLabel}</span>
  </a>
  <ContactActions
    whatsappHref={bookingHref}
    whatsappLabel={t(locale, 'actionWhatsapp')}
    gtmLocation="package_card"
    callLabel={t(locale, 'actionCall')}
    size="compact"
    class="mt-4 w-full"
    locale={locale}
  />
</article>
