---
import OfferCard from './OfferCard.astro';
import type { Locale } from '../i18n/types';

export interface Props {
  offers: {
    slug: string;
    name: string;
    subtitle: string;
    description: string;
    price: string;
    originalPrice: string;
    features: string[];
  }[];
  locale?: Locale;
}

const { offers, locale = 'ar' } = Astro.props;
---

<div class="grid grid-cols-1 items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {offers.map((offer) => <OfferCard offer={offer} locale={locale} />)}
</div>
