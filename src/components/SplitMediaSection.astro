---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import type { SiteAction } from '../data/site';
import type { Locale } from '../i18n/types';
import { localImage } from '../lib/site-images';

export interface Props {
  locale?: Locale;
  eyebrow: string;
  title: string;
  paragraphs: string[];
  image: string;
  imageAlt: string;
  imagePosition?: 'left' | 'right';
  surface?: 'primary' | 'secondary';
  primaryAction?: SiteAction;
  secondaryAction?: SiteAction;
}

const {
  locale = 'ar',
  eyebrow,
  title,
  paragraphs,
  image,
  imageAlt,
  imagePosition = 'right',
  surface = 'secondary',
  primaryAction,
  secondaryAction,
} = Astro.props;

const contentDir = locale === 'en' ? 'ltr' : 'rtl';
const imageDesktopOrder = imagePosition === 'left' ? 'lg:order-1' : 'lg:order-2';
const contentDesktopOrder = imagePosition === 'left' ? 'lg:order-2' : 'lg:order-1';
const imageMeta = localImage(image);
---

<section
  data-split-media
  class:list={['section-block', surface === 'primary' ? 'bg-bg-primary' : 'bg-bg-secondary']}
>
  <div class="page-container grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <div class:list={['order-1 text-start', contentDesktopOrder]} dir={contentDir}>
      <SectionHeading eyebrow={eyebrow} title={title} />
      <div class="mt-4 flex flex-col gap-4">
        {paragraphs.map((paragraph) => <p class="text-base leading-6 text-text-muted">{paragraph}</p>)}
      </div>
      <slot />
      {
        (primaryAction || secondaryAction) && (
          <div class="mt-8 flex flex-wrap gap-4">
            {primaryAction && (
              <a href={primaryAction.href} class="gold-button">
                <img src="/assets/icons/arrow.svg" alt="" width="16" height="16" class="size-4" />
                {primaryAction.label}
              </a>
            )}
            {secondaryAction && (
              <a href={secondaryAction.href} class="outline-button">
                {secondaryAction.label}
              </a>
            )}
          </div>
        )
      }
    </div>

    <figure class:list={['order-2 overflow-hidden rounded-3xl border border-border-card', imageDesktopOrder]}>
      <Picture
        src={imageMeta}
        formats={['avif', 'webp']}
        widths={[480, 768, 1152]}
        sizes="(max-width: 1023px) calc(100vw - 40px), min(576px, 45vw)"
        quality="mid"
        loading="lazy"
        alt={imageAlt}
        class="h-auto min-h-[320px] w-full object-cover lg:h-[520px]"
      />
    </figure>
  </div>
</section>
