---
import BranchCard from './BranchCard.astro';
import type { Branch } from '../data/branches';
import type { Locale } from '../i18n/types';

export interface Props {
  branches: Branch[];
  locale?: Locale;
}

const { branches, locale = 'ar' } = Astro.props;

const gridClass =
  branches.length === 1
    ? 'mx-auto w-full max-w-[390px] grid-cols-1'
    : 'grid-cols-1 lg:grid-cols-3';
---

<div data-branch-grid class={`grid gap-6 ${gridClass}`}>
  {branches.map((branch) => <BranchCard branch={branch} locale={locale} />)}
</div>
