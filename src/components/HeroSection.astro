---
export interface Props {
  badge?: string;
  title?: string;
  description: string;
  descriptionLine2?: string;
}

const { badge, title, description, descriptionLine2 } = Astro.props;
const hasTitleSlot = Astro.slots.has('title');
---

<section data-hero-content class="flex min-h-[413px] flex-col items-center overflow-hidden bg-transparent">
  <div class="flex w-full max-w-[896px] flex-col items-center justify-center gap-6 px-8 py-24">
    {
      badge && (
        <div class="flex items-center gap-2 rounded-full border border-border-badge bg-bg-badge px-4 py-1.5">
          <img src="/assets/icons/star.svg" alt="" width="14" height="14" class="size-3.5" />
          <span class="text-gold text-xs font-medium">{badge}</span>
        </div>
      )
    }
    <h1
      data-hero-title
      class:list={[
        'max-w-[896px] text-center text-4xl font-bold leading-[1.25] py-2 tracking-[0.48px] sm:text-5xl lg:text-[60px]',
        !hasTitleSlot && 'text-gold-gradient',
      ]}
    >
      {hasTitleSlot ? <slot name="title" /> : title}
    </h1>
    <div class="max-w-[768px] text-center text-base leading-[1.625] text-text-muted sm:text-lg">
      <p>{description}</p>
      {descriptionLine2 && <p>{descriptionLine2}</p>}
    </div>
  </div>
</section>
