---
import { socialLinks as defaultSocialLinks } from '../data/site';

export interface SocialLink {
  label: string;
  href: string;
  icon: string;
}

export interface Props {
  links?: SocialLink[];
  showLabel?: boolean;
}

const {
  showLabel = false,
  links = defaultSocialLinks,
} = Astro.props;
---

<div class="flex items-center gap-3">
  {showLabel && <span class="text-sm text-text-muted">تابعنا:</span>}
  {
    links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-[36px] items-center justify-center rounded-full border border-border-input transition-colors hover:bg-gold/10"
        aria-label={link.label}
      >
        <img src={link.icon} alt="" width="16" height="16" class="size-4" />
      </a>
    ))
  }
</div>
