---
import UiIcon, { type UiIconName } from './UiIcon.astro';
import { getSocialLinks } from '../data/site';
import type { Locale } from '../i18n/types';

export interface SocialLink {
  label: string;
  href: string;
  icon: UiIconName;
}

export interface Props {
  links?: SocialLink[];
  showLabel?: boolean;
  locale?: Locale;
}

const {
  showLabel = false,
  locale = 'ar',
  links = getSocialLinks(locale),
} = Astro.props;
const followLabel = locale === 'en' ? 'Follow us:' : 'تابعنا:';
---

<div class="flex items-center gap-3">
  {showLabel && <span class="text-sm text-text-muted">{followLabel}</span>}
  {
    links.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="flex size-[36px] items-center justify-center rounded-full border border-border-input transition-colors hover:bg-gold/10"
        aria-label={link.label}
      >
        <UiIcon name={link.icon} class="size-4 text-gold" />
      </a>
    ))
  }
</div>
