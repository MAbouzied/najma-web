---
import UiIcon from './UiIcon.astro';
import { GTM_EVENTS, gtmContactAttrs } from '../lib/gtm';
import { WHATSAPP_PHONE } from '../lib/whatsapp';
import { offers, packages, services } from '../data/home';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';

export interface Props {
  sectionLabel?: string;
  title?: string;
  description?: string;
  locale?: Locale;
  compact?: boolean;
}

const { sectionLabel, title, description, locale = 'ar', compact = false } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const labels = {
  phone: t(locale, 'contactFormPhone'),
  name: t(locale, 'contactFormName'),
  service: t(locale, 'contactFormService'),
  message: t(locale, 'contactFormMessage'),
  phonePh: t(locale, 'contactFormPhonePlaceholder'),
  namePh: t(locale, 'contactFormNamePlaceholder'),
  servicePh: t(locale, 'contactFormServicePlaceholder'),
  messagePh: t(locale, 'contactFormMessagePlaceholder'),
  submit: t(locale, 'contactFormSubmit'),
};
const waLabels =
  locale === 'en'
    ? { name: 'Name', phone: 'Phone', service: 'Service', message: 'Notes' }
    : { name: 'اسمي', phone: 'رقمي', service: 'الخدمة', message: 'ملاحظات' };
---

<article class:list={['rounded-3xl bg-bg-form', compact ? 'p-5 sm:p-6' : 'p-6 sm:p-8']} dir={dir}>
  {!compact && sectionLabel && <span class="text-sm font-medium text-gold">{sectionLabel}</span>}
  {!compact && title && (
    <h2 class="text-gold-gradient mt-2 text-start text-4xl font-bold leading-tight tracking-[0.48px] sm:text-5xl">
      {title}
    </h2>
  )}
  {!compact && description && (
    <p class="mt-3 text-start text-sm leading-6 text-text-muted sm:text-base">{description}</p>
  )}

  <form
    id="contact-form"
    class:list={['flex w-full flex-col gap-4', !compact && 'mt-5']}
    dir={dir}
    data-locale={locale}
    data-whatsapp-phone={WHATSAPP_PHONE}
    data-label-name={waLabels.name}
    data-label-phone={waLabels.phone}
    data-label-service={waLabels.service}
    data-label-message={waLabels.message}
    {...gtmContactAttrs(GTM_EVENTS.formSubmit, 'contact_form')}
  >
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="flex flex-col gap-2">
        <label for="phone" class="text-sm text-text-muted">{labels.phone}</label>
        <input class="form-control" id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" pattern="(?:\+?966|0)?5[0-9]{8}" placeholder={labels.phonePh} required />
      </div>
      <div class="flex flex-col gap-2">
        <label for="name" class="text-sm text-text-muted">{labels.name}</label>
        <input class="form-control" id="name" name="name" type="text" autocomplete="name" placeholder={labels.namePh} required />
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label for="service" class="text-sm text-text-muted">{labels.service}</label>
      <select class="form-control" id="service" name="service" required>
        <option value="">{labels.servicePh}</option>
        <optgroup label={locale === 'en' ? 'Services' : 'الخدمات'}>
          {services.map((service) => (
            <option value={`service:${service.slug}`}>{service.title[locale]}</option>
          ))}
        </optgroup>
        <optgroup label={locale === 'en' ? 'Packages' : 'الباقات'}>
          {packages.map((packageItem) => (
            <option value={`package:${packageItem.slug}`}>{packageItem.name[locale]}</option>
          ))}
        </optgroup>
        <optgroup label={locale === 'en' ? 'Offers' : 'العروض'}>
          {offers.map((offer) => (
            <option value={`offer:${offer.slug}`}>{offer.name[locale]}</option>
          ))}
        </optgroup>
      </select>
    </div>

    <div class="flex flex-col gap-2 pb-1.5">
      <label for="message" class="text-sm text-text-muted">{labels.message}</label>
      <textarea class="form-control" id="message" name="message" placeholder={labels.messagePh} rows="5"></textarea>
    </div>

    <button type="submit" class:list={['gold-button', compact ? 'w-full' : 'self-start']}>
      <UiIcon name="send" class="size-4 text-text-btn" />
      {labels.submit}
    </button>
    <p data-form-status class="text-sm text-text-muted" role="status" aria-live="polite"></p>
    <label class="hidden" aria-hidden="true">
      Company
      <input name="company" type="text" tabindex="-1" autocomplete="off" />
    </label>
  </form>
</article>

<script>
  import { submitCustomerLead } from '../lib/customer-leads';

  document.getElementById('contact-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const phone = String(data.get('phone') ?? '').trim();
    const serviceValue = String(data.get('service') ?? '');
    const message = String(data.get('message') ?? '').trim();
    const company = String(data.get('company') ?? '');
    const [department, service] = serviceValue.split(':');
    const serviceSelect = form.elements.namedItem('service');
    const serviceLabel = serviceSelect instanceof HTMLSelectElement
      ? serviceSelect.selectedOptions[0]?.textContent?.trim() ?? ''
      : '';
    const labels = {
      name: form.dataset.labelName ?? '',
      phone: form.dataset.labelPhone ?? '',
      service: form.dataset.labelService ?? '',
      message: form.dataset.labelMessage ?? '',
    };

    const body = [
      `*${labels.name}:* ${name}`,
      `*${labels.phone}:* ${phone}`,
      `*${labels.service}:* ${serviceLabel}`,
      message && `*${labels.message}:* ${message}`,
    ].filter(Boolean).join('\n');

    const whatsappWindow = window.open('about:blank', '_blank');
    if (whatsappWindow) whatsappWindow.opener = null;
    const button = form.querySelector('button[type="submit"]');
    const status = form.querySelector('[data-form-status]');
    if (button instanceof HTMLButtonElement) button.disabled = true;
    if (status) status.textContent = form.dataset.locale === 'en' ? 'Saving your details...' : 'جاري حفظ بياناتك...';

    await submitCustomerLead({
      name,
      phone,
      department: department as 'service' | 'package' | 'offer',
      service,
      page: window.location.pathname,
      language: form.dataset.locale === 'en' ? 'en' : 'ar',
      company,
    });

    const url = `https://api.whatsapp.com/send/?phone=${form.dataset.whatsappPhone}&text=${encodeURIComponent(body)}&type=phone_number&app_absent=0`;
    if (whatsappWindow) whatsappWindow.location.href = url;
    else window.location.href = url;
    if (button instanceof HTMLButtonElement) button.disabled = false;
  });
</script>
