---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/types';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import { siteImage } from '../lib/site-images';

export interface Props {
  size?: 'header' | 'footer';
  current?: boolean;
  locale?: Locale;
  showName?: boolean;
  link?: boolean;
}

const { size = 'header', current = false, locale = 'ar', showName = true, link = true } = Astro.props;
const imageSize = size === 'footer' ? 'size-20' : 'size-12';
const pixelSize = size === 'footer' ? 160 : 96;
const homeHref = localePath('/', locale);
const Tag = link ? 'a' : 'span';
---

<Tag
  href={link ? homeHref : undefined}
  class="inline-flex items-center gap-2"
  aria-label={link ? t(locale, 'brandHomeAria') : t(locale, 'brandName')}
  aria-current={link && current ? 'page' : undefined}
>
  <Image
    src={siteImage.logo}
    alt=""
    width={pixelSize}
    height={pixelSize}
    format="png"
    quality="max"
    loading="eager"
    decoding="async"
    class:list={['brand-logo-mark block object-contain', imageSize]}
  />
  {showName && (
    <span class="text-gold-gradient hidden text-xl font-bold tracking-[0.2px] lg:inline">
      {t(locale, 'brandName')}
    </span>
  )}
</Tag>
