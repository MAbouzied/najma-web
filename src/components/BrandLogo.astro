---
import { Image } from 'astro:assets';
import type { Locale } from '../i18n/types';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import { siteImage } from '../lib/site-images';

export interface Props {
  size?: 'header' | 'footer';
  current?: boolean;
  locale?: Locale;
}

const { size = 'header', current = false, locale = 'ar' } = Astro.props;
const imageSize = size === 'footer' ? 'size-[71px]' : 'size-[45px]';
const pixelSize = size === 'footer' ? 71 : 45;
const homeHref = localePath('/', locale);
---

<a
  href={homeHref}
  class="inline-flex items-center gap-2"
  aria-label={t(locale, 'brandHomeAria')}
  aria-current={current ? 'page' : undefined}
>
  <Image
    src={siteImage.logo}
    alt=""
    width={pixelSize}
    height={pixelSize}
    format="webp"
    quality="mid"
    loading="eager"
    decoding="async"
    class:list={['block object-contain', imageSize]}
  />
  <span class:list={['text-gold-gradient font-bold tracking-[0.2px]', size === 'footer' ? 'text-xl' : 'text-xl']}>
    {t(locale, 'brandName')}
  </span>
</a>
