---
import TestimonialCard from './TestimonialCard.astro';
import type { ResolvedTestimonial } from './TestimonialCard.astro';
import type { Locale } from '../i18n/types';

export interface Props {
  testimonials: ResolvedTestimonial[];
  locale?: Locale;
}

const { testimonials, locale = 'ar' } = Astro.props;
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  {testimonials.map((testimonial) => <TestimonialCard testimonial={testimonial} locale={locale} />)}
</div>
