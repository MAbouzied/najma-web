---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { SiteAction } from '../data/site';
import { gtmAttrsForHref } from '../lib/gtm';
import { siteImage } from '../lib/site-images';

export interface Props {
  title: string;
  description: string;
  primaryAction?: SiteAction;
  secondaryAction?: SiteAction;
  backgroundImage?: ImageMetadata;
}

const {
  title,
  description,
  primaryAction,
  secondaryAction,
  backgroundImage = siteImage.contactCta,
} = Astro.props;

function isHttp(href: string) {
  return href.startsWith('http');
}
---

<section data-site-cta class="w-full overflow-hidden bg-bg-primary">
  <div class="page-container section-block">
    <div class="relative min-h-[390px] overflow-hidden rounded-3xl">
      <Image
        src={backgroundImage}
        alt=""
        widths={[640, 960, 1280]}
        sizes="(max-width: 1280px) calc(100vw - 40px), 1216px"
        format="webp"
        quality="mid"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 size-full object-cover opacity-30"
      />
      <div class="cta-overlay absolute inset-0"></div>
      <div class="relative z-10 mx-auto flex max-w-[768px] flex-col items-center justify-center gap-4 px-6 py-28 text-center">
        <h2 class="text-gold-gradient text-center text-4xl font-bold leading-tight tracking-[0.48px] sm:text-5xl">
          {title}
        </h2>
        <p class="max-w-[576px] text-center text-base leading-6 text-text-muted">
          {description}
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
          {primaryAction && (
            <a
              href={primaryAction.href}
              target={isHttp(primaryAction.href) ? '_blank' : undefined}
              rel={isHttp(primaryAction.href) ? 'noopener noreferrer' : undefined}
              class="gold-button"
              {...gtmAttrsForHref(primaryAction.href, 'cta')}
            >
              {primaryAction.label}
            </a>
          )}
          {secondaryAction && (
            <a
              href={secondaryAction.href}
              target={isHttp(secondaryAction.href) ? '_blank' : undefined}
              rel={isHttp(secondaryAction.href) ? 'noopener noreferrer' : undefined}
              class="outline-button"
              {...gtmAttrsForHref(secondaryAction.href, 'cta')}
            >
              {secondaryAction.label}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
