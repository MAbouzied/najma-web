---
import type { Testimonial } from '../data/home';

export interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<figure data-testimonial-card class="flex h-full flex-col rounded-[20px] border border-border-card bg-bg-card p-8 text-right" dir="rtl">
  <div class="flex justify-start gap-1" aria-label="تقييم 5 من 5">
    {Array.from({ length: 5 }).map(() => (
      <img src="/assets/icons/rating-star.svg" alt="" width="16" height="16" class="size-4" />
    ))}
  </div>
  <blockquote class="mt-4 flex-1 text-sm leading-[1.625] text-text-muted">“{testimonial.quote}”</blockquote>
  <figcaption class="mt-6 border-t border-border-card/70 pt-4">
    <p class="text-lg font-semibold leading-7 tracking-[0.18px] text-text-primary">{testimonial.name}</p>
    <p class="mt-0.5 text-xs leading-4 text-gold">{testimonial.service}</p>
  </figcaption>
</figure>
