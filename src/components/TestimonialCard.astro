---
import type { Locale } from '../i18n/types';
import { t } from '../i18n/t';

export interface ResolvedTestimonial {
  quote: string;
  name: string;
  service?: string;
}

export interface Props {
  testimonial: ResolvedTestimonial;
  locale?: Locale;
}

const { testimonial, locale = 'ar' } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
---

<figure data-testimonial-card class="flex h-full flex-col rounded-[20px] border border-border-card bg-bg-card p-8 text-start" dir={dir}>
  <div
    class="flex justify-start gap-0.5 text-gold"
    role="img"
    aria-label={t(locale, 'testimonialRatingAria')}
  >
    {Array.from({ length: 5 }).map(() => (
      <svg class="size-4 shrink-0 fill-current" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M8 1.33398L9.72604 5.80604L14.667 6.39304L11.333 9.52704L12.452 14.393L8 11.806L3.54804 14.393L4.66704 9.52704L1.33304 6.39304L6.27404 5.80604L8 1.33398Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />
      </svg>
    ))}
  </div>
  <blockquote class="mt-4 flex-1 text-sm leading-[1.625] text-text-muted">“{testimonial.quote}”</blockquote>
  <figcaption class="mt-6 border-t border-border-card/70 pt-4">
    <p class="text-lg font-semibold leading-7 tracking-[0.18px] text-text-primary">{testimonial.name}</p>
    {testimonial.service ? (
      <p class="mt-0.5 text-xs leading-4 text-gold">{testimonial.service}</p>
    ) : null}
  </figcaption>
</figure>
