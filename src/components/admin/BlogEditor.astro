---
import type { AdminPost } from '../../lib/admin/blog-admin.ts';

interface Props {
  post: AdminPost;
  services: Array<{ id: string; title: string }>;
}

const { post, services } = Astro.props;
const data = JSON.stringify({ post, services }).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
---

<style>
  .file-upload-label { position: relative; display: grid; gap: 8px; }
  .file-upload-label input[type='file'] { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .file-upload-control { display: grid; gap: 3px; padding: 13px 14px; border: 1px dashed #d58ba0; border-radius: 12px; background: #fff8fa; color: #8a4960; cursor: pointer; }
  .file-upload-control:hover { border-color: #b85d7a; background: #fff1f5; }
  .file-upload-control small { color: #ad8895; font-size: 11px; font-weight: 500; }
  .image-upload-preview { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border: 1px solid #f0dfe3; border-radius: 12px; background: #fff8fa; }
  .image-upload-status { padding: 9px 10px; border-radius: 9px; background: #f8f1f3; color: #79505d; font-size: 12px; font-weight: 700; }
  .image-upload-status.error { background: #fff0f0; color: #b04444; }
</style>

<section class="editor-view">
  <div class="editor-topbar">
    <a class="text-button" href="/admin" data-navigation>← العودة للمقالات</a>
    <span>{post.title ? 'تحرير المقال' : 'مقال جديد'}</span>
  </div>
  <form id="post-form" class="post-form">
    <div class="editor-grid">
      <div class="editor-column">
        <label>عنوان المقال<input name="title" required maxlength="160" placeholder="اكتب عنواناً واضحاً" /></label>
        <label>الرابط المختصر<input name="slug" maxlength="160" placeholder="يُنشأ تلقائياً من العنوان" /></label>
        <label>المقدمة<textarea name="excerpt" required maxlength="320" rows="3" placeholder="ملخص قصير يظهر في بطاقات المدونة"></textarea></label>
        <div class="content-field">
          <div class="field-heading"><label for="content-editor">محتوى المقال</label><span>استخدم الأدوات لتنسيق النص</span></div>
          <div class="rich-toolbar" role="toolbar" aria-label="تنسيق النص">
            <button type="button" data-command="undo" title="تراجع">↶</button><button type="button" data-command="redo" title="إعادة">↷</button><i></i>
            <button type="button" data-block="p">نص</button><button type="button" data-block="h2">H2</button><button type="button" data-block="h3">H3</button><i></i>
            <button type="button" data-command="bold"><strong>B</strong></button><button type="button" data-command="italic"><em>I</em></button><button type="button" data-command="underline"><u>U</u></button><button type="button" data-command="strikeThrough"><s>S</s></button><i></i>
            <button type="button" data-command="insertUnorderedList">• قائمة</button><button type="button" data-command="insertOrderedList">1. قائمة</button><button type="button" data-command="formatBlock" data-value="blockquote">❝ اقتباس</button><i></i>
            <button type="button" id="add-link">رابط</button><button type="button" id="add-image">صورة</button><button type="button" id="add-video">فيديو</button>
          </div>
          <div id="content-editor" class="content-editor" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="ابدأ كتابة المقال هنا…"></div>
        </div>
      </div>
      <aside class="editor-side">
        <div class="side-card"><h2>النشر</h2><input type="hidden" name="category" value="عام" /><label>الكاتب<input name="author" value="فريق نجم سبا" /></label><label class="check-row"><input name="featured" type="checkbox" /> مقال مميز</label><div class="side-actions"><button type="button" class="button button-secondary" id="save-draft">حفظ كمسودة</button><button type="button" class="button button-primary" id="publish-post">نشر المقال</button></div></div>
        <div class="side-card image-card"><h2>الصورة الرئيسية</h2><input type="hidden" name="coverAssetId" /><label class="file-upload-label">رفع صورة من جهازك<input id="cover-file" name="coverFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/svg+xml" /><span class="file-upload-control"><span>اختيار صورة</span><small>PNG أو JPG أو WEBP حتى 10MB</small></span></label><div class="image-upload-status" id="cover-upload-status" hidden></div><img id="cover-preview" class="image-upload-preview" alt="" hidden /><label>رابط الصورة<input id="cover-url" name="coverUrl" placeholder="https://… أو /assets/…" /></label><label>الوصف البديل<input id="cover-alt" name="coverAlt" placeholder="وصف الصورة" /></label><p class="field-help">يمكنك رفع الصورة إلى Sanity أو الاحتفاظ باستخدام رابط صورة موجود حالياً.</p></div>
        <div class="side-card"><h2>خدمة مرتبطة <span>(اختياري)</span></h2><select name="relatedServiceId" id="service-select"><option value="">بدون خدمة مرتبطة</option>{services.map((service) => <option value={service.id}>{service.title}</option>)}</select></div>
        <button type="button" class="button button-preview" id="preview-post">معاينة المقال</button>
      </aside>
    </div>
  </form>
</section>

<script type="application/json" id="editor-data" set:html={data} is:inline></script>

<script>
  type EditorData = { post: { id: string; title: string; slug: string; excerpt: string; contentHtml: string; featured: boolean; category: string; author: string; coverUrl: string; coverAlt: string; coverAssetId: string; coverWidth: number | null; coverHeight: number | null; relatedServiceId: string }; services: Array<{ id: string; title: string }> };
  const dataElement = document.querySelector<HTMLScriptElement>('#editor-data');
  const data = JSON.parse(dataElement?.textContent || '{}') as EditorData;
  const post = data.post;
  const form = document.querySelector<HTMLFormElement>('#post-form')!;
  const content = document.querySelector<HTMLElement>('#content-editor')!;
  const status = document.querySelector<HTMLElement>('#admin-status');
  if (!post) throw new Error('تعذر تجهيز محرر المقال');
  const esc = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] || char));
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  const notify = (message: string, error = false) => { if (!status) return; status.textContent = message; status.hidden = false; status.classList.toggle('error', error); window.setTimeout(() => { status.hidden = true; }, 4000); };
  const setValue = (name: string, value: string) => { field(name).value = value || ''; };
  setValue('title', post.title); setValue('slug', post.slug); setValue('excerpt', post.excerpt); setValue('category', post.category || 'عام'); setValue('author', post.author || 'فريق نجم سبا'); setValue('coverUrl', post.coverUrl); setValue('coverAlt', post.coverAlt); setValue('coverAssetId', post.coverAssetId); setValue('relatedServiceId', post.relatedServiceId); (field('featured') as HTMLInputElement).checked = post.featured; content.innerHTML = post.contentHtml || '';
  const coverFile = document.querySelector<HTMLInputElement>('#cover-file');
  const coverPreview = document.querySelector<HTMLImageElement>('#cover-preview');
  const coverUploadStatus = document.querySelector<HTMLElement>('#cover-upload-status');
  const coverUrl = document.querySelector<HTMLInputElement>('#cover-url');
  const coverAlt = document.querySelector<HTMLInputElement>('#cover-alt');
  const showCoverPreview = (src: string, alt: string) => { if (!coverPreview) return; if (src) { coverPreview.src = src; coverPreview.alt = alt || 'معاينة الصورة الرئيسية'; coverPreview.hidden = false; } else { coverPreview.removeAttribute('src'); coverPreview.hidden = true; } };
  const setCoverUploadStatus = (message: string, error = false) => { if (!coverUploadStatus) return; coverUploadStatus.textContent = message; coverUploadStatus.hidden = !message; coverUploadStatus.classList.toggle('error', error); };
  showCoverPreview(post.coverUrl, post.coverAlt || post.title);
  let dirty = false;
  const markDirty = () => { dirty = true; };
  form.addEventListener('input', markDirty); content.addEventListener('input', markDirty);
  window.addEventListener('beforeunload', (event) => { if (!dirty) return; event.preventDefault(); });
  document.querySelectorAll<HTMLAnchorElement>('[data-navigation]').forEach((link) => link.addEventListener('click', (event) => { if (dirty && !window.confirm('لديك تغييرات غير محفوظة. هل تريد المغادرة؟')) event.preventDefault(); }));
  async function api(path: string, options: RequestInit = {}) { const headers = new Headers(options.headers); if (!(options.body instanceof FormData)) headers.set('Content-Type', 'application/json'); const response = await fetch(`/api/admin/blog/${path}`, { ...options, headers }); const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(result.error || 'حدث خطأ غير متوقع'); return result; }
  function payload() { return { title: field('title').value, slug: field('slug').value, excerpt: field('excerpt').value, contentHtml: content.innerHTML, category: field('category').value, author: field('author').value, coverUrl: field('coverUrl').value, coverAlt: field('coverAlt').value, coverAssetId: field('coverAssetId').value, relatedServiceId: field('relatedServiceId').value, featured: (field('featured') as HTMLInputElement).checked }; }
  async function save(publish: boolean, goToPreview = false) {
    if (publish && !form.reportValidity()) return;
    const body = payload();
    if (publish && !body.contentHtml.replace(/<[^>]+>/g, '').trim()) { notify('أضف محتوى المقال قبل النشر', true); return; }
    try {
      await api(`posts/${encodeURIComponent(post.id)}`, { method: 'PUT', body: JSON.stringify(body) });
      if (publish) await api(`posts/${encodeURIComponent(post.id)}/publish`, { method: 'POST' });
      dirty = false;
      if (goToPreview) window.location.assign(`/admin/${encodeURIComponent(post.id)}/preview`);
      else notify(publish ? 'تم نشر المقال' : 'تم حفظ المسودة');
    } catch (error) { notify(error instanceof Error ? error.message : 'تعذر حفظ المقال', true); }
  }
  document.querySelector('#save-draft')?.addEventListener('click', () => save(false));
  document.querySelector('#publish-post')?.addEventListener('click', () => save(true));
  document.querySelector('#preview-post')?.addEventListener('click', () => save(false, true));
  coverUrl?.addEventListener('input', () => { setValue('coverAssetId', ''); showCoverPreview(coverUrl.value.trim(), coverAlt?.value || ''); markDirty(); });
  coverAlt?.addEventListener('input', () => { if (coverPreview && !coverPreview.hidden) coverPreview.alt = coverAlt.value || 'معاينة الصورة الرئيسية'; });
  coverFile?.addEventListener('change', async () => {
    const file = coverFile.files?.[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) { setCoverUploadStatus('اختر ملف صورة صالحاً.', true); coverFile.value = ''; return; }
    if (file.size > 10 * 1024 * 1024) { setCoverUploadStatus('حجم الصورة يجب ألا يتجاوز 10 ميجابايت.', true); coverFile.value = ''; return; }
    const formData = new FormData(); formData.append('file', file, file.name); formData.append('alt', coverAlt?.value || file.name);
    setCoverUploadStatus('جارٍ رفع الصورة إلى Sanity…');
    try {
      const uploaded = await api('assets', { method: 'POST', body: formData }) as { assetId: string; url: string };
      setValue('coverAssetId', uploaded.assetId); setValue('coverUrl', uploaded.url); if (coverAlt && !coverAlt.value) coverAlt.value = file.name.replace(/\.[^.]+$/, ''); showCoverPreview(uploaded.url, coverAlt?.value || file.name); setCoverUploadStatus('تم رفع الصورة بنجاح.'); markDirty();
    } catch (error) { setCoverUploadStatus(error instanceof Error ? error.message : 'تعذر رفع الصورة.', true); }
  });
  const runCommand = (command: string, value?: string) => { const exec = (document as unknown as { execCommand: (commandId: string, showUI?: boolean, value?: string) => boolean }).execCommand; content.focus(); exec.call(document, command, false, value); markDirty(); };
  document.querySelectorAll<HTMLButtonElement>('[data-command]').forEach((button) => button.addEventListener('click', () => runCommand(button.dataset.command || '', button.dataset.value)));
  document.querySelectorAll<HTMLButtonElement>('[data-block]').forEach((button) => button.addEventListener('click', () => runCommand('formatBlock', button.dataset.block)));
  document.querySelector('#add-link')?.addEventListener('click', () => { const url = window.prompt('أدخل الرابط'); if (url) runCommand('createLink', url); });
  document.querySelector('#add-image')?.addEventListener('click', () => { const url = window.prompt('رابط الصورة'); if (!url) return; const alt = window.prompt('الوصف البديل') || ''; runCommand('insertHTML', `<figure><img src="${esc(url)}" alt="${esc(alt)}" /><figcaption>${esc(alt)}</figcaption></figure>`); });
  document.querySelector('#add-video')?.addEventListener('click', () => { const raw = window.prompt('رابط فيديو YouTube أو Vimeo'); if (!raw) return; try { const parsed = new URL(raw); let embed = ''; if (parsed.hostname.includes('youtu.be')) embed = `https://www.youtube-nocookie.com/embed/${parsed.pathname.slice(1)}`; else if (parsed.hostname.includes('youtube.com')) embed = `https://www.youtube-nocookie.com/embed/${parsed.searchParams.get('v') || parsed.pathname.split('/').pop()}`; else if (parsed.hostname.includes('vimeo.com')) embed = `https://player.vimeo.com/video/${parsed.pathname.split('/').filter(Boolean).pop()}`; if (embed) runCommand('insertHTML', `<figure><iframe src="${esc(embed)}" title="فيديو المقال" loading="lazy"></iframe></figure>`); } catch { notify('أدخل رابط فيديو صالحاً من YouTube أو Vimeo', true); } });
</script>
