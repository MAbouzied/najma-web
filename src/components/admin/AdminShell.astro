---
import AdminLayout from '../../layouts/AdminLayout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  subtitle: string;
  active?: 'overview' | 'editor' | 'preview' | 'users';
  headerActionHref?: string;
  headerActionLabel?: string;
}

const {
  title,
  description,
  heading,
  subtitle,
  active = 'overview',
  headerActionHref = '/admin/create',
  headerActionLabel = 'مقال جديد',
} = Astro.props;
---

<AdminLayout title={title} description={description} locale="ar">
  <main class="admin-shell" dir="rtl">
    <aside class="admin-sidebar">
      <a href="/" class="admin-brand">نجم سبا <span>المدونة</span></a>
      <nav aria-label="التنقل الإداري">
        <a class:list={['nav-button', { 'is-active': active === 'overview' || active === 'editor' || active === 'preview' }]} href="/admin">المقالات</a>
        <a class:list={['nav-button', { 'is-active': active === 'users' }]} href="/admin/users">المستخدمون</a>
        <a class="nav-button" href="/blogs/">عرض المدونة</a>
      </nav>
      <a class="new-post-button" href="/admin/create">+ مقال جديد</a>
    </aside>

    <section class="admin-main">
      <header class="admin-header">
        <div>
          <p class="admin-kicker">لوحة التحرير</p>
          <h1>{heading}</h1>
          <p class="admin-subtitle">{subtitle}</p>
        </div>
        <div class="admin-actions">
          <a class="button button-primary" href={headerActionHref}>{headerActionLabel}</a>
        </div>
      </header>
      <div id="admin-status" class="admin-status" role="status" hidden></div>
      <slot />
    </section>
  </main>
</AdminLayout>

<style is:global>
  .admin-shell{min-height:100dvh;display:flex;align-items:stretch;color:#36232b;font-family:inherit}
  .admin-sidebar{position:sticky;top:0;align-self:flex-start;width:248px;height:100dvh;min-height:100dvh;overflow-y:auto;background:#3b2630;color:#fff;padding:28px 18px;display:flex;flex-direction:column;gap:32px}
  .admin-brand{font-size:19px;font-weight:900;color:#fff;text-decoration:none;padding:0 10px}
  .admin-brand span{display:block;color:#f4b6c6;font-size:12px;margin-top:4px}
  .admin-sidebar nav{display:grid;gap:6px}
  .nav-button{border:0;background:transparent;color:#f8e9ed;text-decoration:none;text-align:right;padding:12px 14px;border-radius:12px;font:inherit;font-size:14px;cursor:pointer}
  .nav-button:hover,.nav-button.is-active{background:#593846;color:#fff}
  .new-post-button{border:1px solid #e99fb3;background:#e99fb3;color:#3b2630;text-decoration:none;text-align:center;border-radius:12px;padding:12px;font:inherit;font-weight:800;cursor:pointer;margin-top:auto}
  .admin-main{flex:1;min-width:0;min-height:100dvh;padding:32px clamp(18px,4vw,56px) 70px}
  .admin-header{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;border-bottom:1px solid #f0dfe3;padding-bottom:25px}
  .admin-kicker{color:#ba5674;font-size:12px;font-weight:900;margin:0 0 8px}
  .admin-header h1{font-size:34px;line-height:1.1;margin:0;font-weight:900}
  .admin-subtitle{color:#8a6f78;margin:10px 0 0;line-height:1.8}
  .button{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:11px;padding:12px 18px;font:inherit;font-weight:800;text-decoration:none;cursor:pointer}
  .button-primary{background:#bd5d7c;color:#fff}
  .button-primary:hover{background:#a94c6c}
  .button-secondary{background:#f7e7eb;color:#6d3347}
  .button-preview{width:100%;background:#fff;border:1px solid #e7cbd3;color:#7e3f56}
  .button:focus-visible,.nav-button:focus-visible,.new-post-button:focus-visible,.text-button:focus-visible{outline:3px solid #f2c8d5;outline-offset:2px}
  .text-button{background:none;border:0;color:#93425e;font:inherit;font-weight:800;cursor:pointer;text-decoration:none}
  .admin-status{margin:18px 0;padding:12px 15px;border-radius:10px;background:#edf8f0;color:#2d7246}
  .admin-status.error{background:#fff0f0;color:#a53535}
  .stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:26px 0}
  .stat-card,.list-card,.side-card{background:#fff;border:1px solid #f0dfe3;border-radius:16px;box-shadow:0 8px 26px rgba(83,36,50,.04)}
  .stat-card{padding:18px 20px}.stat-card span{display:block;color:#977681;font-size:13px}.stat-card strong{display:block;font-size:30px;margin-top:6px}
  .posts-view{display:grid;gap:18px;max-width:1120px}
  .list-card{overflow:hidden;border-radius:22px}
  .list-header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:26px 28px 23px;background:linear-gradient(180deg,#fff 0%,#fffafb 100%)}
  .list-eyebrow{margin:0 0 5px;color:#ad5472;font-size:11px;font-weight:900;letter-spacing:.04em}.list-header h2{margin:0;color:#3c2931;font-size:22px;line-height:1.3}.list-description{margin:7px 0 0;color:#917984;font-size:13px;line-height:1.7}
  .list-total{display:grid;place-items:center;min-width:74px;padding:10px 14px;border:1px solid #f0dce2;border-radius:15px;background:#fff;color:#8c6372}.list-total strong{color:#a74667;font-size:25px;line-height:1;font-weight:900}.list-total span{margin-top:5px;font-size:11px;font-weight:700}
  .list-tools{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 22px;border-top:1px solid #f3e7ea;border-bottom:1px solid #f3e7ea;background:#fff}.search{position:relative;display:block;flex:1;max-width:390px}.search-icon{position:absolute;inset-inline-start:12px;top:50%;z-index:1;color:#ad8895;font-size:21px;line-height:1;transform:translateY(-54%) rotate(-20deg);pointer-events:none}.search input{width:100%;min-width:0;padding:11px 14px 11px 37px;border:1px solid #e8d9de;border-radius:11px;background:#fff;color:#4a303a;font:inherit;font-size:13px}.search input:focus,.filter select:focus{border-color:#c46d88;box-shadow:0 0 0 3px #f8e6ec;outline:0}.filter{display:flex;align-items:center;gap:8px;color:#9a7782;font-size:12px;font-weight:700;white-space:nowrap}.filter select{min-width:135px;width:auto;border:1px solid #e8d9de;border-radius:11px;background:#fff;color:#5c3c49;padding:10px 32px 10px 11px;font:inherit;font-size:13px;cursor:pointer}
  .post-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding:22px;background:#f8f4f5}.blog-admin-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;border-radius:16px;background:#fff;box-shadow:0 8px 24px -14px rgba(61,31,42,.3);transition:box-shadow .2s ease,transform .2s ease}.blog-admin-card:hover{box-shadow:0 18px 38px -18px rgba(61,31,42,.38);transform:translateY(-2px)}.blog-card-media{position:relative;overflow:hidden;aspect-ratio:16/10;background:#eadfe2}.blog-card-media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s cubic-bezier(.22,1,.36,1)}.blog-admin-card:hover .blog-card-media img{transform:scale(1.025)}.blog-card-placeholder{display:grid;width:100%;height:100%;place-items:center;background:#f2e8eb;color:#9e6679;font-size:24px;font-weight:900}.blog-card-flags{position:absolute;inset:12px 12px auto;display:flex;align-items:center;justify-content:space-between;gap:8px;pointer-events:none}.blog-card-status,.blog-card-featured{display:inline-flex;min-height:28px;align-items:center;gap:6px;padding:5px 9px;border-radius:999px;background:#fff;color:#315f41;box-shadow:0 4px 14px rgba(52,34,40,.14);font-size:11px;font-weight:800}.blog-card-status::before{width:6px;height:6px;border-radius:50%;background:#3e9d5e;content:""}.blog-card-status.is-draft{color:#805f22}.blog-card-status.is-draft::before{background:#c39131}.blog-card-featured{margin-inline-start:auto;color:#7a5921}.blog-card-body{display:flex;flex:1;flex-direction:column;padding:18px 18px 16px}.blog-card-date{margin:0 0 8px;color:#896e77;font-size:11px;font-weight:700}.blog-card-title{display:-webkit-box;overflow:hidden;margin:0;color:#35242b;font-size:16px;font-weight:900;line-height:1.65;-webkit-box-orient:vertical;-webkit-line-clamp:2}.blog-card-excerpt{display:-webkit-box;overflow:hidden;margin:9px 0 0;color:#755d66;font-size:12px;line-height:1.75;-webkit-box-orient:vertical;-webkit-line-clamp:2}.blog-card-author{margin:auto 0 0;padding-top:14px;color:#9c7e88;font-size:11px}.blog-card-actions{margin-top:auto;padding:0 16px 15px}.blog-card-actions-main{display:grid;grid-template-columns:1.15fr .85fr;gap:8px}.blog-card-actions button{min-height:38px;border-radius:10px;font:inherit;font-size:12px;font-weight:800;cursor:pointer}.blog-card-edit{border:1px solid #b85676;background:#b85676;color:#fff}.blog-card-preview{border:1px solid #e1ced4;background:#fff;color:#684551}.blog-card-actions-sub{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:9px;padding-top:9px;border-top:1px solid #f1e7ea}.blog-card-actions-sub button{min-height:30px;border:0;border-radius:7px;background:transparent;padding:4px 6px;color:#765a64;font-size:11px}.blog-card-actions-sub .blog-card-publish{color:#277245}.blog-card-actions-sub .blog-card-unpublish{color:#8b6929}.blog-card-actions-sub .blog-card-delete{margin-inline-start:auto;color:#a34149}.blog-card-actions button:hover{filter:brightness(.96)}
  .empty-state{display:grid;grid-column:1/-1;gap:7px;padding:54px 24px;color:#806872;text-align:center}.empty-state strong{color:#4d333d;font-size:15px}.empty-state span{font-size:13px}
  .editor-topbar{display:flex;justify-content:space-between;align-items:center;padding:15px 0 25px;color:#967b84;font-size:13px}.editor-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:22px}.editor-column{display:grid;gap:17px}.post-form label{display:grid;gap:7px;color:#5c3e48;font-weight:800;font-size:13px}.post-form input,.post-form textarea,.post-form select{width:100%;border:1px solid #e8d5db;background:#fff;border-radius:10px;padding:12px 13px;font:inherit;color:#3b2630;font-weight:500}.post-form input:focus,.post-form textarea:focus,.post-form select:focus{outline:3px solid #f4d4dd;border-color:#bd5d7c}.content-field{background:#fff;border:1px solid #e8d5db;border-radius:14px;overflow:hidden}.field-heading{display:flex;justify-content:space-between;align-items:center;padding:14px 15px;border-bottom:1px solid #f1e3e6}.field-heading label{display:block}.field-heading span,.field-help,.side-card h2 span{font-size:11px;color:#a78991;font-weight:500}.rich-toolbar{display:flex;flex-wrap:wrap;gap:4px;padding:9px;border-bottom:1px solid #f1e3e6;background:#fffaf9}.rich-toolbar button{border:0;background:transparent;color:#70424f;padding:7px 8px;border-radius:6px;font:inherit;font-size:12px;cursor:pointer}.rich-toolbar button:hover{background:#f7e5e9}.rich-toolbar i{width:1px;background:#ead9dd;margin:4px 3px}.content-editor{min-height:420px;padding:20px;line-height:2;font-size:16px;outline:0}.content-editor:empty:before{content:attr(data-placeholder);color:#bda6ad}.content-editor img{max-width:100%;height:auto}.content-editor blockquote{border-right:3px solid #d9829b;margin:16px 0;padding:8px 16px;background:#fff6f7}.editor-side{display:grid;align-content:start;gap:15px}.side-card{padding:17px;display:grid;gap:14px}.side-card h2{margin:0;font-size:15px}.check-row{display:flex!important;align-items:center;gap:8px!important}.check-row input{width:auto}.side-actions{display:grid;gap:8px}.preview-view{margin-top:24px}.preview-bar{display:flex;justify-content:space-between;align-items:center;padding:15px 0 24px;border-bottom:1px solid #f0dfe3;color:#977681;font-weight:800}.preview-article{background:#fff;border:1px solid #f0dfe3;border-radius:16px;padding:clamp(22px,5vw,70px);margin:25px auto;max-width:860px;line-height:2;font-size:17px}.preview-article h1{font-size:clamp(28px,4vw,46px);line-height:1.2;margin:0 0 14px;color:#3b2630}.preview-article h2{font-size:26px;margin-top:30px}.preview-article h3{font-size:22px;margin-top:24px}.preview-article blockquote{border-right:4px solid #d9829b;background:#fff6f7;padding:12px 18px;margin:22px 0}.preview-article img{max-width:100%;border-radius:12px}.preview-article iframe{width:100%;min-height:360px;border:0;border-radius:12px}.preview-cover{display:block;width:100%;max-height:460px;object-fit:cover;border-radius:14px;margin:24px 0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  @media(max-width:900px){.admin-shell{display:block}.admin-sidebar{position:relative;top:auto;width:auto;height:auto;min-height:0;overflow:visible;flex-direction:row;align-items:center;padding:16px}.admin-sidebar nav{display:flex}.admin-sidebar .new-post-button{margin:0 0 0 auto}.admin-main{min-height:0;padding:22px 15px 50px}.editor-grid{grid-template-columns:1fr}.editor-side{grid-row:1}.admin-header{display:block}.admin-actions{margin-top:18px}.stats-grid{gap:8px}.stat-card{padding:13px}.stat-card strong{font-size:24px}.post-list{gap:15px;padding:17px}.post-list{grid-template-columns:repeat(2,minmax(0,1fr))}.list-header{padding:21px 18px}.list-tools{align-items:stretch;padding:12px 16px}.search{max-width:none}.post-title{white-space:normal}.blog-card-body{padding-inline:15px}.blog-card-actions{padding-inline:13px}.blog-card-actions button{font-size:11px}}
  @media(max-width:560px){.admin-header h1{font-size:29px}.stats-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.list-header{align-items:flex-start}.list-total{min-width:62px;padding:8px 10px}.list-header h2{font-size:19px}.list-description{font-size:12px}.list-tools{display:grid;grid-template-columns:1fr}.filter{justify-content:space-between}.filter select{flex:1}.post-list{grid-template-columns:1fr;padding:12px}.blog-card-media{aspect-ratio:16/9}.blog-card-actions button{font-size:12px}.preview-bar{gap:10px;flex-wrap:wrap}.preview-bar .button{margin-inline-start:auto}}
</style>
