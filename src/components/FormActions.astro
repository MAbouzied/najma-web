---
import UiIcon from './UiIcon.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { GTM_EVENTS, gtmContactAttrs } from '../lib/gtm';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';
import { buildCallHref, buildGeneralContactUrl, MAPS_HREF } from '../lib/whatsapp';

export interface Props {
  locale?: Locale;
}

const { locale = 'ar' } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const whatsappHref = buildGeneralContactUrl(locale);
const callHref = buildCallHref();
const offersHref = localePath('/offers/', locale);
---

<article
  class="flex w-full min-w-0 flex-col gap-3 rounded-3xl bg-bg-form p-5 sm:p-6"
  aria-label={t(locale, 'formActionsAria')}
  data-form-actions
  dir={dir}
>
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="gold-button w-full min-h-14 text-base"
    {...gtmContactAttrs(GTM_EVENTS.whatsapp, 'form_landing')}
  >
    <WhatsAppIcon class="size-5 text-text-btn" />
    {t(locale, 'formWhatsappAction')}
  </a>
  <a
    href={callHref}
    class="outline-button w-full min-h-14 text-base"
    {...gtmContactAttrs(GTM_EVENTS.call, 'form_landing')}
  >
    <UiIcon name="phone" class="size-5" />
    {t(locale, 'formCallAction')}
  </a>
  <a
    href={MAPS_HREF}
    target="_blank"
    rel="noopener noreferrer"
    class="outline-button w-full min-h-14 text-base"
  >
    <UiIcon name="location" class="size-5" />
    {t(locale, 'formLocationAction')}
  </a>
  <a href={offersHref} class="gold-button w-full min-h-14 text-base">
    {t(locale, 'formOffersAction')}
  </a>
</article>
