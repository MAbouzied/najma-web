---
import BookingForm from '../components/BookingForm.astro';
import Header from '../components/Header.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
---

<SiteLayout
  title={t(locale, 'bookPageTitle')}
  description={t(locale, 'bookPageDescription')}
  pathname={localePath('/book/', locale)}
  pageType="WebPage"
  robots="noindex, follow"
  locale={locale}
>
  <div data-hero-shell class="bg-bg-hero">
    <Header locale={locale} />
  </div>
  <section class="section-block bg-bg-primary">
    <div class="page-container">
      <div class="mx-auto w-full min-w-0 max-w-3xl" dir={dir}>
        <span class="text-sm font-semibold text-gold">{t(locale, 'bookPageEyebrow')}</span>
        <h1 class="text-gold-gradient mt-3 text-3xl font-bold leading-tight sm:text-4xl md:text-6xl">
          {t(locale, 'bookPageHeading')}
        </h1>
        <p class="mt-4 max-w-2xl leading-8 text-text-muted">{t(locale, 'bookPageLead')}</p>
        <div class="mt-9">
          <BookingForm locale={locale} />
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
