---
import BrandLogo from '../components/BrandLogo.astro';
import BranchesSection from '../components/BranchesSection.astro';
import FormActions from '../components/FormActions.astro';
import ContactForm from '../components/ContactForm.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBranches } from '../data/branches';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const formHref = localePath('/form/', locale);
const branches = getBranches(locale);
---

<SiteLayout
  title={t(locale, 'formPageTitle')}
  description={t(locale, 'formPageDescription')}
  pathname={formHref}
  pageType="ContactPage"
  image="/assets/contact-cta.jpg"
  robots="noindex, follow"
  showFloatingContact={false}
  showFooter={false}
  locale={locale}
>
  <section class="min-h-dvh bg-bg-primary" dir={dir}>
    <div class="page-container flex min-h-dvh w-full min-w-0 flex-col py-8 sm:py-10">
      <div class="flex items-center justify-between gap-4">
        <BrandLogo locale={locale} showName={false} link={false} />
        <div class="flex items-center gap-2">
          <LanguageSwitcher locale={locale} />
        </div>
      </div>

      <h1 class="mt-6 truncate text-sm font-semibold text-text-primary">
        {t(locale, 'formHeading')}
      </h1>

      <div class="mt-6 grid w-full min-w-0 flex-1 grid-cols-1 items-start gap-10 lg:grid-cols-2 lg:items-stretch lg:gap-16">
        <div class="min-w-0">
          <BranchesSection
            sectionLabel={t(locale, 'homeBranchesEyebrow')}
            branches={branches}
            locale={locale}
            compact
          />
          <FormActions locale={locale} />
        </div>
        <div class="order-first grid min-w-0 place-items-center rtl:lg:order-none">
          <ContactForm whatsappOnly locale={locale} />
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
