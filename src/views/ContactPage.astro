---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import HeroSection from '../components/HeroSection.astro';
import InfoCards from '../components/InfoCards.astro';
import ContactForm from '../components/ContactForm.astro';
import BranchesSection from '../components/BranchesSection.astro';
import CTASection from '../components/CTASection.astro';
import { getBranches } from '../data/branches';
import { getBookingAction, getCallAction, getContactDetails } from '../data/site';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const branches = getBranches(locale);
const booking = getBookingAction(locale);
const call = getCallAction(locale);
const contact = getContactDetails(locale);
const breadcrumbs = [
  { label: t(locale, 'breadcrumbHome'), href: localePath('/', locale) },
  { label: t(locale, 'breadcrumbContact'), href: localePath('/contact/', locale) },
];
---

<SiteLayout
  title={t(locale, 'contactPageTitle')}
  description={t(locale, 'contactPageDescription')}
  pathname={localePath('/contact/', locale)}
  pageType="ContactPage"
  image="/assets/contact-cta.jpg"
  breadcrumbs={breadcrumbs}
  locale={locale}
>
  <div data-hero-shell class="bg-bg-hero">
    <Header currentPage="contact" locale={locale} />
    <div class="page-container pt-6">
      <Breadcrumbs items={breadcrumbs} locale={locale} class="mb-0" />
    </div>
    <HeroSection
      badge={t(locale, 'contactHeroBadge')}
      title={t(locale, 'contactHeroTitle')}
      description={t(locale, 'contactHeroDescription')}
    />
  </div>

  <InfoCards
    locale={locale}
    cards={[
      { icon: '/assets/icons/phone.svg', label: t(locale, 'contactLabelPhone'), value: contact.phoneDisplay, href: contact.phoneHref },
      { icon: '/assets/icons/whatsapp.svg', label: t(locale, 'contactLabelWhatsapp'), value: t(locale, 'contactWhatsappValue'), href: booking.href },
      { icon: '/assets/icons/mail.svg', label: t(locale, 'contactLabelEmail'), value: 'info@nagmspa.com', href: 'mailto:info@nagmspa.com' },
      { icon: '/assets/icons/clock.svg', label: t(locale, 'contactLabelHours'), value: contact.hours, href: '#branches' },
    ]}
  />

  <section class="bg-bg-tertiary">
    <div class="page-container section-block">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16">
        <BranchesSection
          sectionLabel={t(locale, 'homeBranchesEyebrow')}
          branches={branches}
          locale={locale}
        />
        <ContactForm
          sectionLabel={t(locale, 'contactFormSection')}
          title={t(locale, 'contactFormTitle')}
          description={t(locale, 'contactFormDescription')}
          locale={locale}
        />
      </div>
    </div>
  </section>

  <CTASection
    title={t(locale, 'contactCtaTitle')}
    description={t(locale, 'contactCtaDescription')}
    primaryAction={{ label: t(locale, 'actionWhatsapp'), href: booking.href }}
    secondaryAction={{ label: t(locale, 'actionCallNow'), href: call.href }}
  />
</SiteLayout>
