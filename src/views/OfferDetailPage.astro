---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactActions from '../components/ContactActions.astro';
import CTASection from '../components/CTASection.astro';
import { getSummerCampaign } from '../data/home';
import { getCallAction } from '../data/site';
import { localePath } from '../i18n/paths';
import { t } from '../i18n/t';
import type { Locale } from '../i18n/types';
import { buildOfferBookingUrl } from '../lib/whatsapp';

export interface Props {
  locale: Locale;
  offer: {
    slug: string;
    name: string;
    subtitle: string;
    description: string;
    price: string;
    originalPrice: string;
    features: string[];
  };
}

const { locale, offer } = Astro.props;
const dir = locale === 'en' ? 'ltr' : 'rtl';
const campaign = getSummerCampaign(locale);
const call = getCallAction(locale);
const offerBookingHref = buildOfferBookingUrl(offer.name, locale);
const srLabel = locale === 'en' ? 'Price before discount ' : 'السعر قبل الخصم ';
const breadcrumbs = [
  { label: t(locale, 'breadcrumbHome'), href: localePath('/', locale) },
  { label: t(locale, 'breadcrumbOffers'), href: localePath('/offers/', locale) },
  { label: offer.name, href: localePath(`/offers/${offer.slug}/`, locale) },
];
---

<SiteLayout
  title={`${offer.name} - ${t(locale, 'brandName')}`}
  description={offer.description}
  pathname={localePath(`/offers/${offer.slug}/`, locale)}
  pageType="WebPage"
  image={null}
  breadcrumbs={breadcrumbs}
  offers={[offer]}
  locale={locale}
>
  <div data-hero-shell class="bg-bg-hero">
    <Header locale={locale} />
  </div>

  <section class="section-block bg-bg-primary">
    <div class="page-container">
      <div class="mx-auto max-w-3xl" dir={dir}>
        <Breadcrumbs items={breadcrumbs} locale={locale} />

        <span class="mb-4 inline-flex items-center rounded-full border border-border-badge bg-bg-badge px-4 py-1 text-xs font-bold text-gold">
          {campaign.discountLabel}
        </span>

        <h1 class="text-4xl font-bold leading-tight text-text-primary">{offer.name}</h1>
        <p class="mt-3 text-lg text-text-muted">{offer.subtitle}</p>
        <p class="mt-4 leading-7 text-text-muted">{offer.description}</p>
        <p class="mt-6 flex flex-wrap items-baseline gap-3">
          <span class="text-4xl font-bold text-gold">{offer.price}</span>
          <s class="text-xl text-text-muted">
            <span class="sr-only">{srLabel}</span>
            {offer.originalPrice}
          </s>
        </p>

        <div class="mt-8 rounded-2xl border border-border-card bg-bg-card p-6">
          <h2 class="mb-4 text-lg font-bold text-text-primary">{t(locale, 'offerDetailComponents')}</h2>
          <ul class="flex flex-col gap-3">
            {offer.features.map((feature) => (
              <li class="flex items-center gap-3 text-sm leading-6 text-text-muted">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-gold/20 text-xs text-gold">✓</span>
                {feature}
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-8 max-w-md">
          <ContactActions whatsappHref={offerBookingHref} gtmLocation="offer_detail" locale={locale} />
        </div>
      </div>
    </div>
  </section>

  <CTASection
    title={t(locale, 'offerDetailCtaTitle')}
    description={t(locale, 'offerDetailCtaDescription')}
    primaryAction={{ label: t(locale, 'actionWhatsapp'), href: offerBookingHref }}
    secondaryAction={{ label: t(locale, 'actionCallNow'), href: call.href }}
  />
</SiteLayout>
