    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "astro-portabletext": "^0.13.0",
    "better-auth": "^1.6.26",
    "prismjs": "^1.30.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "wrangler": "^4.112.0"
